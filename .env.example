# Published image: replace OWNER/REPOSITORY with your GitHub repository.
# KDBX_BACKUP_IMAGE=ghcr.io/OWNER/REPOSITORY:0.1.0
TZ=UTC
# All profiles share this configurable root; each uses its own subdirectory.
KDBX_BACKUP_DATA_ROOT=./var/data
# Homelab layout: KDBX_BACKUP_DATA_ROOT=../../data/kdbx-backup
# Absolute paths are also supported, e.g. /srv/homelab/data/kdbx-backup
# Shared existing Docker network. Create it once if it does not exist.
KDBX_BACKUP_NETWORK=homelab
# Separate development/test deployments need a distinct project name AND data root.
# KDBX_BACKUP_PROJECT_NAME=kdbx-backup-dev
# init records the project owner's UID/GID for Linux bind-mount permissions.
# Existing values are preserved. These settings are shared by all profiles.
# KDBX_BACKUP_UID=1000
# KDBX_BACKUP_GID=1000

# Only configure a proxy if cloud APIs cannot be reached directly from Docker.
# A proxy on the host must listen on an address reachable by containers.
# KDBX_BACKUP_HTTPS_PROXY=http://host.docker.internal:7890
# KDBX_BACKUP_HTTP_PROXY=http://host.docker.internal:7890
# KDBX_BACKUP_NO_PROXY=localhost,127.0.0.1

# Shared by all profiles. The manager sets each profile's config/data/credential
# mount paths and Compose project name. Never copy a full credential file to add
# a person; see docs/family-profiles.md for reusing only backup target remotes.
